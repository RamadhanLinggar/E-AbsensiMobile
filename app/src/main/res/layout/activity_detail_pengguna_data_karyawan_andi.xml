<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ================= HEADER ================= -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="#6FA8FF"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:src="@drawable/header"
            android:scaleType="fitStart"/>
    </RelativeLayout>

    <!-- ================= SIDEBAR ================= -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="120dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintStart_toStartOf="parent">

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#000"/>

        <!-- PROFILE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/ic_profile"
                android:background="@drawable/bg_profile_circle"
                android:padding="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Andi"
                android:textStyle="bold"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accounting"
                android:textSize="11sp"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#000"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnHome"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Home"
            android:textColor="#000"
            android:backgroundTint="#6FA8FF"/>

        <Button
            android:id="@+id/btnRekap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rekap Absensi Bulanan"
            android:textColor="#000"
            android:backgroundTint="#6FA8FF"/>

        <Button
            android:id="@+id/btnKeseluruhan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keseluruhan Data Absensi"
            android:textColor="#000"
            android:backgroundTint="#6FA8FF"/>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#000"/>
    </LinearLayout>

    <!-- GARIS SIDEBAR -->
    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="#000"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintStart_toEndOf="@id/sidebar"/>

    <!-- ================= DETAIL ================= -->
    <LinearLayout
        android:id="@+id/layoutDetail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintStart_toEndOf="@id/sidebar"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama"
            android:textStyle="bold"/>

        <EditText
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:text="Andi"
            android:background="@drawable/edittext_border"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Usia"
            android:textStyle="bold"/>

        <EditText
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:text="23"
            android:background="@drawable/edittext_border"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Posisi"
            android:textStyle="bold"/>

        <EditText
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:text="Accounting"
            android:background="@drawable/edittext_border"/>
    </LinearLayout>



    <!-- ================= REKAP BULAN ================= -->
    <LinearLayout
        android:id="@+id/layoutRekap"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintStart_toEndOf="@id/sidebar"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rekap Absensi Bulanan"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*"
            android:background="#DDDDDD">

            <TableRow android:background="#BBBBBB">
                <TextView android:text="Bulan" android:padding="6dp"/>
                <TextView android:text="Hadir" android:padding="6dp"/>
                <TextView android:text="Telat" android:padding="6dp"/>
                <TextView android:text="Cuti" android:padding="6dp"/>
            </TableRow>

            <TableRow>
                <TextView android:text="Oktober" android:padding="6dp"/>
                <TextView android:text="20" android:padding="6dp"/>
                <TextView android:text="2" android:padding="6dp"/>
                <TextView android:text="1" android:padding="6dp"/>
            </TableRow>

            <TableRow>
                <TextView android:text="November" android:padding="6dp"/>
                <TextView android:text="21" android:padding="6dp"/>
                <TextView android:text="1" android:padding="6dp"/>
                <TextView android:text="0" android:padding="6dp"/>
            </TableRow>

        </TableLayout>

    </LinearLayout>

    <!-- ================= KESELURUHAN DATA ================= -->
    <LinearLayout
        android:id="@+id/layoutKeseluruhan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintStart_toEndOf="@id/sidebar"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Desember 2025"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7"
            android:textSize="22sp"/>
    </LinearLayout>

    <!-- ================= FOOTER ================= -->
    <ImageView
        android:id="@+id/footer"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:src="@drawable/footer"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
